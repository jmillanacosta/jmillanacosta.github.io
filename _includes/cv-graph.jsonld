{%- include cv/data.liquid -%}
{%- assign software = cv.libraries | concat: cv.personal_tools -%}
{
  "@context": {
    "@vocab": "https://schema.org/",
    "schema": "https://schema.org/",
    "foaf": "http://xmlns.com/foaf/0.1/",
    "dcterms": "http://purl.org/dc/terms/",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "@language": "en"
  },
  "@graph": [
    {
      "@id": {{ page_iri | jsonify }},
      "@type": ["ProfilePage", "foaf:PersonalProfileDocument"],
      "name": {{ doc_title | jsonify }},
      "dcterms:title": {{ doc_title | jsonify }},
      "inLanguage": "en",
      "dateModified": {"@value": {{ modified | jsonify }}, "@type": "xsd:date"},
      "dcterms:modified": {"@value": {{ modified | jsonify }}, "@type": "xsd:date"},
      "mainEntity": {"@id": {{ me | jsonify }}},
      "foaf:primaryTopic": {"@id": {{ me | jsonify }}},
      "foaf:maker": {"@id": {{ me | jsonify }}},
      "dcterms:creator": {"@id": {{ me | jsonify }}},
      "encoding": [
        {%- for format in formats -%}{"@id": {{ format.url | prepend: page_iri | jsonify }}, "@type": "MediaObject", "name": {{ format.name | jsonify }}, "encodingFormat": {{ format.type | jsonify }}, "contentUrl": {"@id": {{ format.url | prepend: page_iri | jsonify }}}}{%- unless forloop.last -%}, {% endunless -%}{%- endfor -%}
      ]
    },
    {
      "@id": {{ me | jsonify }},
      "@type": ["Person", "foaf:Person"],
      "name": {{ person.name | jsonify }},
      "foaf:name": {{ person.name | jsonify }},
      "givenName": {{ person.given_name | jsonify }},
      "foaf:givenName": {{ person.given_name | jsonify }},
      "familyName": {{ person.family_name | jsonify }},
      "foaf:familyName": {{ person.family_name | jsonify }},
      "jobTitle": {{ person.job_title | jsonify }},
      {%- if parts contains " description " %}
      "description": {{ person.description | strip | jsonify }},
      {%- endif %}
      "email": {{ person.email | jsonify }},
      "foaf:mbox": {"@id": {{ person.email | prepend: "mailto:" | jsonify }}},
      "url": {"@id": {{ base | jsonify }}},
      "foaf:homepage": {"@id": {{ base | jsonify }}},
      "image": {"@id": {{ base | append: "assets/og-image.png" | jsonify }}},
      "identifier": {"@type": "PropertyValue", "propertyID": "ORCID", "value": {{ person.orcid | append: "" | jsonify }}, "url": {"@id": {{ me | jsonify }}}},
      "address": {"@type": "PostalAddress", "addressLocality": {{ person.address.locality | jsonify }}, "addressCountry": {{ person.address.country | jsonify }}},
      "sameAs": [
        {%- for profile in person.profiles -%}{%- unless profile.url == me -%}{"@id": {{ profile.url | jsonify }}}, {% endunless -%}{%- endfor -%}
        {%- for s in person.same_as -%}{"@id": {{ s | jsonify }}}{%- unless forloop.last -%}, {% endunless -%}{%- endfor -%}
      ],
      "worksFor": [
        {% include ld/org.json key=person.works_for %}
        {%- if parts contains " roles " %}{% assign ld_jobs = cv.experience %}{% elsif parts contains " current-role " %}{% assign ld_jobs = cv.experience | where_exp: "job", "job.end == nil" %}{% else %}{% assign ld_jobs = "" | split: "" %}{% endif -%}
        {%- for job in ld_jobs -%}
        , {"@type": "EmployeeRole", "roleName": [{{ job.role | jsonify }}, {"@id": {{ job.occupation | jsonify }}}], "startDate": {% include ld/date.json value=job.start %}{% if job.end %}, "endDate": {% include ld/date.json value=job.end %}{% endif %}, "description": [{% if job.status %}{{ job.status | jsonify }}, {% endif %}{% for paragraph in job.description %}{{ paragraph | strip | jsonify }}{% unless forloop.last %}, {% endunless %}{% endfor %}], "worksFor": {% include ld/org.json key=job.organization location=true %}}
        {%- endfor %}
      ]
      {%- if parts contains " projects " %},
      "memberOf": [
        {%- for project in cv.funded_projects -%}{"@id": {{ project.iri | jsonify }}, "@type": "ResearchProject", "name": {{ project.name | jsonify }}, "url": {"@id": {{ project.url | jsonify }}}, "funding": {% include ld/grant.json key=project.grant %}}{%- unless forloop.last -%}, {% endunless -%}{%- endfor -%}
      ]
      {%- endif %}
      {%- if parts contains " education " %},
      "alumniOf": [
        {%- for edu in cv.education -%}{%- assign edu_last = forloop.last -%}{"@type": "OrganizationRole", "roleName": {{ edu.degree | jsonify }}, "startDate": {% include ld/date.json value=edu.start %}, "endDate": {% include ld/date.json value=edu.end %}, "description": {{ edu.description | strip | jsonify }}{% if edu.taxa %}, "about": [{% for taxon in edu.taxa %}{% assign t = cv.taxa[taxon] %}{"@id": {{ t.iri | jsonify }}, "@type": "Taxon", "name": {{ taxon | jsonify }}, "sameAs": [{% for s in t.same_as %}{"@id": {{ s | jsonify }}}{% unless forloop.last %}, {% endunless %}{% endfor %}]}{% unless forloop.last %}, {% endunless %}{% endfor %}]{% endif %}, "alumniOf": {% include ld/org.json key=edu.organization %}}{%- for ex in edu.exchanges -%}, {"@type": "OrganizationRole", "roleName": {{ ex.role | jsonify }}{% if ex.start %}, "startDate": {% include ld/date.json value=ex.start %}{% endif %}{% if ex.end %}, "endDate": {% include ld/date.json value=ex.end %}{% endif %}, "alumniOf": {% include ld/org.json key=ex.organization %}}{%- endfor -%}{%- unless edu_last -%}, {% endunless -%}{%- endfor -%}
      ]
      {%- endif %}
      {%- if parts contains " education " or parts contains " credentials " %},
      "hasCredential": [
        {%- if parts contains " education " %}{% for edu in cv.education -%}{"@type": "EducationalOccupationalCredential", "name": {{ edu.degree | jsonify }}, "credentialCategory": {"@id": {{ edu.degree_type | jsonify }}}, "about": {"@id": {{ edu.field | jsonify }}}, "recognizedBy": {"@id": {{ orgs[edu.organization].iri | jsonify }}}, "dateCreated": {% include ld/date.json value=edu.end %}}{% if parts contains " credentials " %}, {% else %}{% unless forloop.last %}, {% endunless %}{% endif %}{% endfor %}{% endif -%}
        {%- if parts contains " credentials " %}{% for credential in cv.credentials -%}{"@type": "EducationalOccupationalCredential", "name": {{ credential.name | jsonify }}, "recognizedBy": {% include ld/org.json key=credential.recognized_by %}, "dateCreated": {% include ld/date.json value=credential.date %}}{%- unless forloop.last -%}, {% endunless -%}{%- endfor %}{% endif -%}
      ]
      {%- endif %}
      {%- if parts contains " languages " %},
      "knowsLanguage": [
        {%- for language in cv.languages -%}{"@type": "Role", "description": {{ language.proficiency | jsonify }}, "knowsLanguage": {"@id": {{ language.iri | jsonify }}, "@type": "Language", "name": {{ language.name | jsonify }}, "alternateName": {{ language.code | jsonify }}, "sameAs": [{% for s in language.same_as %}{"@id": {{ s | jsonify }}}{% unless forloop.last %}, {% endunless %}{% endfor %}]}}{%- unless forloop.last -%}, {% endunless -%}{%- endfor -%}
      ]
      {%- endif %}
      {%- if parts contains " skills " %},
      "knowsAbout": [
        {%- for term in cv.skill_terms -%}{"@id": {{ term[1] | jsonify }}, "name": {{ term[0] | jsonify }}}{%- unless forloop.last -%}, {% endunless -%}{%- endfor -%}
      ]
      {%- endif %}
      {%- if parts contains " events " %},
      "performerIn": [
        {%- for event in events -%}
        {%- if event.funder %}{% assign funding_text = event.funding_note | append: " " | append: orgs[event.funder].name %}{% endif -%}
        {"@type": "Role"{% if event.role %}, "roleName": {{ event.role | jsonify }}{% endif %}{% if event.doi %}, "subjectOf": {"@id": {{ event.doi | prepend: "https://doi.org/" | jsonify }}}{% endif %}{% include ld/mentions.json mentions=event.mentions %}{% if event.funder %}, "funding": {"@type": "Grant", "description": {{ funding_text | jsonify }}, "funder": {% include ld/org.json key=event.funder %}}{% endif %}, "description": {{ event.summary | strip | jsonify }}, "performerIn": { {% if event.iri %}"@id": {{ event.iri | jsonify }}, {% endif %}"@type": "Event", "name": {{ event.name | append: " " | append: event.year | jsonify }}, "keywords": {{ event.type | jsonify }}
          {%- assign event_start = event.start | default: event.year | append: "" %}, "startDate": {% include ld/date.json value=event_start %}
          {%- if event.end %}, "endDate": {% include ld/date.json value=event.end %}{% endif %}
          {%- if event.url %}, "url": {"@id": {{ event.url | jsonify }}}{% endif %}
          {%- if event.recording %}, "recordedIn": {"@id": {{ event.recording | jsonify }}}{% endif %}
          {%- if event.series %}, "superEvent": {"@id": {{ event.series | jsonify }}}{% endif %}
          {%- if event.location == "Online" %}, "eventAttendanceMode": {"@id": "https://schema.org/OnlineEventAttendanceMode"}, "location": {"@type": "VirtualLocation", "name": "Online"}
          {%- elsif event.location %}, "location": {"@id": {{ cv.places[event.location] | jsonify }}, "@type": "Place", "name": {{ event.location | jsonify }}}{% endif -%}
        }}{%- unless forloop.last -%}, {% endunless -%}
        {%- endfor -%}
      ]
      {%- endif %}
    }
    {%- if parts contains " communities " %}{% for community in cv.communities %},
    {"@id": {{ community.iri | jsonify }}, "@type": "Project", "name": {{ community.name | jsonify }}, "url": {"@id": {{ community.url | jsonify }}}, "contributor": {"@id": {{ me | jsonify }}}}
    {%- endfor %}{% endif %}
    {%- if parts contains " teaching " %}{% for course in cv.teaching %},
    { {% if course.iri %}"@id": {{ course.iri | jsonify }}, {% endif %}"@type": "Course", "name": {{ course.name | jsonify }}{% if course.url %}, "url": {"@id": {{ course.url | jsonify }}}{% endif %}{% if course.code %}, "courseCode": {{ course.code | jsonify }}{% endif %}{% if course.program %}, "isPartOf": {"@type": "EducationalOccupationalProgram", "name": {{ course.program | jsonify }}{% if course.program_url %}, "url": {"@id": {{ course.program_url | jsonify }}}{% endif %}}{% endif %}, "provider": {"@id": {{ orgs[cv.teaching_provider].iri | jsonify }}}, "hasCourseInstance": {"@type": "CourseInstance", "instructor": {"@id": {{ me | jsonify }}}{% include ld/mentions.json mentions=course.mentions %}, "description": {{ course.description | strip | jsonify }}}}
    {%- endfor %}{% endif %}
    {%- if parts contains " software " %}{% for item in software %}
    {%- assign item_stats = stats | where: "id", item.id | first %}
    {%- assign pkg = nil %}{% if item.package %}{% assign pkg = site.data.software | where: "name", item.package | first %}{% endif %}
    , {"@id": {{ item.iri | jsonify }}, "@type": "SoftwareSourceCode", "name": {{ item.name | jsonify }}, "codeRepository": {"@id": {{ item.repository | jsonify }}}{% if item.url %}, "url": {"@id": {{ item.url | jsonify }}}{% endif %}{% if pkg %}, "softwareVersion": {{ pkg.version | jsonify }}, "downloadUrl": {"@id": {{ pkg.pypi_url | jsonify }}}{% if pkg.docs %}, "softwareHelp": {"@id": {{ pkg.docs | jsonify }}}{% endif %}{% endif %}{% if item.docs %}, "softwareHelp": {"@id": {{ item.docs | jsonify }}}{% endif %}, "author": {"@id": {{ me | jsonify }}}, "description": {{ item.description | strip | jsonify }}{% include ld/papers.json item=item %}, "interactionStatistic": {% include ld/stats.json stats=item_stats %}}
    {%- endfor %}{% endif %}
    {%- if parts contains " contributions " %}{% for item in cv.contributions %}
    {%- assign item_stats = stats | where: "id", item.id | first %}
    , {"@id": {{ item.iri | jsonify }}, "@type": "SoftwareSourceCode", "name": {{ item.name | jsonify }}, "url": {"@id": {{ item.url | jsonify }}}{% if item.repository %}, "codeRepository": {"@id": {{ item.repository | jsonify }}}{% endif %}{% if item.doi %}, {{ item.doi_relation | default: "sameAs" | jsonify }}: {"@id": {{ item.doi | prepend: "https://doi.org/" | jsonify }}}{% endif %}, "contributor": {"@type": "Role", "contributor": {"@id": {{ me | jsonify }}}{% include ld/mentions.json mentions=item.mentions %}, "description": {{ item.description | strip | jsonify }}}{% include ld/papers.json item=item %}, "interactionStatistic": {% include ld/stats.json stats=item_stats %}}
    {%- endfor %}{% endif %}
    {%- if parts contains " publications " %}{% for deliverable in cv.deliverables %}
    , {"@type": "Report", "name": {{ deliverable.title | jsonify }}, "dcterms:title": {{ deliverable.title | jsonify }}, "reportNumber": {{ deliverable.number | jsonify }}, "datePublished": {% include ld/date.json value=deliverable.date %}, "dcterms:date": {% include ld/date.json value=deliverable.date %}{% if deliverable.url %}, "url": {"@id": {{ deliverable.url | jsonify }}}{% endif %}, "funding": {% include ld/grant.json key=deliverable.grant %}, "contributor": {"@id": {{ me | jsonify }}}, "dcterms:contributor": {"@id": {{ me | jsonify }}}}
    {%- endfor %}
    {%- for pub in site.data.publications %}
    {%- assign pub_same = cv.publication_same_as[pub.doi] %}
    {%- assign venue = cv.venues[pub.journal] %}
    , { {% if pub.doi %}"@id": {{ pub.doi | prepend: "https://doi.org/" | jsonify }}, {% endif %}"@type": "ScholarlyArticle", "name": {{ pub.title | jsonify }}, "dcterms:title": {{ pub.title | jsonify }}, "datePublished": {"@value": {{ pub.year | append: "" | jsonify }}, "@type": "xsd:gYear"}, "dcterms:date": {"@value": {{ pub.year | append: "" | jsonify }}, "@type": "xsd:gYear"}, "genre": {{ pub.type | replace: "-", " " | capitalize | jsonify }}{% if pub.doi %}, "identifier": {{ pub.doi | jsonify }}{% endif %}{% if pub_same %}, "sameAs": {"@id": {{ pub_same | jsonify }}}{% endif %}{% if pub.journal %}, "isPartOf": { {% if venue %}"@id": {{ venue | jsonify }}, {% endif %}"@type": "Periodical", "name": {{ pub.journal | jsonify }}}{% endif %}, "author": {% if pub.authors %}{"@list": [{% for a in pub.authors %}{% if a.me %}{"@id": {{ me | jsonify }}}{% else %}{% assign a_full = a.given | append: " " | append: a.family | strip %}{ {% if a.orcid %}"@id": {{ a.orcid | jsonify }}, {% endif %}"@type": "Person", "name": {{ a_full | jsonify }}}{% endif %}{% unless forloop.last %}, {% endunless %}{% endfor %}]}{% else %}{"@id": {{ me | jsonify }}}{% endif %}, "dcterms:creator": {"@id": {{ me | jsonify }}}}
    {%- endfor %}{% endif %}
  ]
}
