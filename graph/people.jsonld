---
layout: null
permalink: /graph/people.jsonld
---
{%- comment -%}
  People around the CV: software contributors (GitHub) and co-authors (ORCID), from
  _data/people.yml (scripts/update_cv_data.py).
{%- endcomment -%}
{%- assign cv = site.data.cv -%}
{%- assign software = cv.libraries | concat: cv.contributions | concat: cv.personal_tools -%}
{%- assign first = true -%}
{
  "@context": {"@vocab": "https://schema.org/", "dcterms": "http://purl.org/dc/terms/", "@language": "en"},
  "@graph": [
    {%- for p in site.data.people %}
    {%- if p.names or p.same_as or p.websites %}
    {% unless first %},{% endunless %}{"@id": {{ p.id | jsonify }}, "@type": "Person"
      {%- if p.names %}, "name": [{% for n in p.names %}{{ n.name | jsonify }}{% unless forloop.last %}, {% endunless %}{% endfor %}]{% endif %}
      {%- if p.same_as %}, "sameAs": [{% for s in p.same_as %}{"@id": {{ s | jsonify }}}{% unless forloop.last %}, {% endunless %}{% endfor %}]{% endif %}
      {%- if p.websites %}, "url": [{% for w in p.websites %}{"@id": {{ w.url | jsonify }}}{% unless forloop.last %}, {% endunless %}{% endfor %}]{% endif %}}
    {%- for w in p.websites %}, {"@id": {{ w.url | jsonify }}, "@type": "WebSite", "dcterms:source": {"@id": {{ w.source | jsonify }}}}{% endfor %}
    {%- comment -%}An account tied by a record (ORCID, Wikidata) cites it; inferred ties keep their evidence in _data/people.yml.{%- endcomment -%}
    {%- for acct in p.accounts %}{% if acct.via == "declared on ORCID record" or acct.via == "Wikidata" %}, {"@id": {{ acct.url | jsonify }}, "dcterms:source": {"@id": {{ acct.source | jsonify }}}}{% endif %}{% endfor %}
    {%- assign first = false %}
    {%- endif %}
    {%- endfor %}
    {%- for item in software %}
    {%- assign contributors = site.data.people | where_exp: "p", "p.contributes contains item.id" %}
    {%- if contributors.size > 0 %}
    {% unless first %},{% endunless %}{"@id": {{ item.iri | jsonify }}, "contributor": [{% for p in contributors %}{"@id": {{ p.id | jsonify }}}{% unless forloop.last %}, {% endunless %}{% endfor %}]}
    {%- assign first = false %}
    {%- endif %}
    {%- endfor %}
  ]
}
